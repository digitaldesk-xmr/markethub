{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key",
    "WEB3FORMS_ACCESS_KEY": "@web3forms_access_key",
    "ADMIN_SECRET": "@admin_secret"
  }
}
